# drop — Apache config for shared hosting

# A request for the bare directory (/drop/) serves the upload page.
DirectoryIndex index.php

# Short links: /drop/Ab3xK9 → f.php?c=Ab3xK9  (legacy /drop/f/Ab3xK9 still works)
RewriteEngine On
# Explicit base so per-dir rewrites map back to the public URL even when
# this folder is reached via a symlink/alias (without it, Apache's
# docroot-strip heuristic fails there and directory/shortlink rewrites 500).
RewriteBase /drop

# Serve the upload page for the bare directory request (/drop/) via
# rewrite, not DirectoryIndex — mod_dir's index subrequest 500s on this
# host while a direct hit on index.php works fine.
RewriteRule ^$ index.php [L]

# PHP-FPM/CGI strips the Authorization header — pass it through for Bearer auth
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^f/([A-Za-z0-9]+)$ f.php?c=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9]{4,16})$ f.php?c=$1 [L,QSA]

# Never serve these directly
<FilesMatch "^(config\.php|lib\.php|apikey\.php|\.user\.ini)$">
  Require all denied
</FilesMatch>

# Upload size limits (works when PHP runs as mod_php; if your host uses
# PHP-FPM/CGI, the same values are in .user.ini instead)
<IfModule mod_php.c>
  php_value upload_max_filesize 310M
  php_value post_max_size 320M
  php_value max_execution_time 600
  php_value max_input_time 600
  php_value memory_limit 256M
</IfModule>
