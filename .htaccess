# drop — Apache config for shared hosting.
#
# NOTE (datapot.org's 20i host): any RewriteRule in THIS file makes the
# server return 500 for the rewritten requests, while identical rules at
# the docroot work. All drop rewrites (short links /drop/CODE and /drop/f/CODE,
# plus the FPM Authorization passthrough) therefore live in the DOCROOT
# .htaccess — see server/public_html.htaccess in the datapot_www repo.
# Directory-index handling (/drop/ -> index.php) also comes from the docroot.

# Never serve these directly
<FilesMatch "^(config\.php|lib\.php|apikey\.php|\.user\.ini)$">
  Require all denied
</FilesMatch>

# Upload size limits (works when PHP runs as mod_php; if your host uses
# PHP-FPM/CGI, the same values are in .user.ini instead)
<IfModule mod_php.c>
  php_value upload_max_filesize 310M
  php_value post_max_size 320M
  php_value max_execution_time 600
  php_value max_input_time 600
  php_value memory_limit 256M
</IfModule>
